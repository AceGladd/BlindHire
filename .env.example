# ==========================================
# AgenticHR (BlindHire) Environment Variables
# ==========================================

# 1. Database Configuration (Prisma)
# SQLite is used by default. Point to a local .db file.
DATABASE_URL="file:./dev.db"

# 2. Email / SMTP Configuration (Nodemailer)
# Used for sending interview invitations and notifications.
# If using Gmail, use an "App Password", NOT your actual login password.
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="your_16_char_app_password"

# 3. LLM API Keys
# GROQ is used for ATS parsing & deep analysis.
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY_HERE"

# Google Gemini 3.6 Flash Lite is used for real-time AI Video Interview Dialogue Orchestrator.
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"

# Optional: ai_agent orchestrator provider switch. Defaults to "groq" if unset.
# Set to "gemini" only for local fallback testing when the Groq free-tier quota
# is exhausted — requires GEMINI_API_KEY below. Never commit real key values.
# LLM_PROVIDER="groq"
# GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"

# 4. App URL (Optional but recommended for production)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
